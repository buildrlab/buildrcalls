{
  "name": "buildrcalls",
  "version": "0.1.1",
  "description": "BuildrCalls by BuildrLab: call planning and local transcription",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:mac": "electron-builder --mac dmg",
    "dist:win": "electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "productName": "BuildrCalls",
  "build": {
    "appId": "com.buildrlab.buildrcalls",
    "productName": "BuildrCalls",
    "asar": true,
    "files": [
      "index.html",
      "styles.css",
      "renderer.js",
      "preload.js",
      "main.js",
      "transcription.js",
      "settings.js",
      "ipc-validation.js",
      "data-store.js",
      "call-form.js",
      "buildrlab-logo.svg",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "extendInfo": {
        "NSAudioCaptureUsageDescription": "BuildrCalls records call audio with your permission."
      }
    },
    "win": {
      "target": [
        "zip"
      ],
      "signAndEditExecutable": false
    }
  }
}
